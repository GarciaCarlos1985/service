# ============================================================
# SERVICE GUIDE — exemplo de variáveis (commitar este arquivo)
# Copie para .env.local e preencha. Guia completo: ENVIRONMENT.md
# NUNCA coloque service key ou segredos em variáveis VITE_*.
# ============================================================

# Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# Apenas autenticação da ferramenta de deploy; nunca bindings do Worker.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Opcional: ferramentas de gerenciamento do Supabase (nunca no navegador).
# SUPABASE_ACCESS_TOKEN=
# PGSSLROOTCERT=caminho/para/certificado-ca.crt

# Privados: ferramentas de ativacao Auth; nunca usar prefixo VITE_.
# TURNSTILE_SECRET_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
