{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "service-guide",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {
    "required": [],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
